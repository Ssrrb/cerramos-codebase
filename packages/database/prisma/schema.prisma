// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

model Page {
  id   Int    @id @default(autoincrement())
  name String
}

enum CommerceTrustState {
  pending_review
  verified
  limited
  rejected
  suspended
}

enum ProductLinkStatus {
  draft
  active
  inactive
  expired
}

enum FulfillmentType {
  delivery
  pickup
}

enum DeliveryMode {
  delivery
  pickup
}

enum OrderStatus {
  new
  pending_payment
  paid
  confirmed
  expired
  cancelled
}

enum PaymentStatus {
  not_required
  pending
  authorized
  paid
  failed
  expired
  cancelled
}

enum PaymentRiskState {
  pending
  held
  release_ready
  reverse_pending
  reversed
}

enum PaymentProviderName {
  pagopar_upay
  manual
}

enum PaymentMethodType {
  in_store
  cash_on_delivery
  upay_card
  upay_bank_transfer
  other
}

enum CustomerIdentityProvider {
  password
  google
}

enum AppUserRole {
  buyer
  merchant_admin
  operator
}

model Commerce {
  id                      String             @id @default(cuid())
  name                    String
  slug                    String             @unique
  legalName               String?
  trustState              CommerceTrustState @default(pending_review)
  trustScore              Int                @default(0)
  defaultOrderExpiryHours Int                @default(24)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  users                   AppUser[]
  productLinks            ProductLink[]
  orders                  Order[]
}

model AppUser {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String?
  role         AppUserRole    @default(buyer)
  commerceId   String?
  customerId   String?
  commerce     Commerce?      @relation(fields: [commerceId], references: [id])
  customer     Customer?      @relation(fields: [customerId], references: [id])
  sessions     AuthSession[]
  oauthAccount OAuthAccount[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model AuthSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime?
  user       AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OAuthAccount {
  id                String                   @id @default(cuid())
  userId            String
  provider          CustomerIdentityProvider
  providerAccountId String
  user              AppUser                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model ProductLink {
  id              String                @id @default(cuid())
  commerceId      String
  slug            String                @unique
  title           String
  description     String?
  imageUrl        String?
  currency        String                @default("PYG")
  unitPrice       Int
  status          ProductLinkStatus     @default(draft)
  paymentRequired Boolean               @default(false)
  pickupEnabled   Boolean               @default(true)
  deliveryEnabled Boolean               @default(true)
  expiresAt       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  commerce        Commerce              @relation(fields: [commerceId], references: [id], onDelete: Cascade)
  variants        ProductVariantOption[]
  orders          Order[]
  orderItems      OrderItem[]
}

model ProductVariantOption {
  id              String      @id @default(cuid())
  productLinkId   String
  name            String
  value           String
  additionalPrice Int         @default(0)
  isDefault       Boolean     @default(false)
  productLink     ProductLink @relation(fields: [productLinkId], references: [id], onDelete: Cascade)
}

model Customer {
  id         String             @id @default(cuid())
  email      String?            @unique
  name       String?
  phone      String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  users      AppUser[]
  identities CustomerIdentity[]
  consents   CustomerConsent[]
  orders     Order[]
  deliveries DeliveryInfo[]
}

model CustomerIdentity {
  id              String                   @id @default(cuid())
  customerId      String
  provider        CustomerIdentityProvider
  providerSubject String
  passwordHash    String?
  createdAt       DateTime                 @default(now())
  customer        Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
}

model CustomerConsent {
  id         String   @id @default(cuid())
  customerId String
  type       String
  granted    Boolean  @default(false)
  grantedAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model DeliveryInfo {
  id            String       @id @default(cuid())
  customerId    String?
  mode          DeliveryMode
  recipientName String
  email         String
  phone         String
  addressLine1  String?
  addressLine2  String?
  city          String?
  reference     String?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  customer      Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orders        Order[]
}

model Order {
  id              String             @id @default(cuid())
  commerceId      String
  productLinkId   String
  customerId      String
  deliveryInfoId  String
  orderStatus     OrderStatus        @default(new)
  paymentStatus   PaymentStatus      @default(not_required)
  fulfillmentType FulfillmentType
  quantity        Int                @default(1)
  note            String?
  subtotal        Int
  total           Int
  currency        String             @default("PYG")
  expiresAt       DateTime
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  commerce        Commerce           @relation(fields: [commerceId], references: [id], onDelete: Restrict)
  productLink     ProductLink        @relation(fields: [productLinkId], references: [id], onDelete: Restrict)
  customer        Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  deliveryInfo    DeliveryInfo       @relation(fields: [deliveryInfoId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  paymentIntents  PaymentIntent[]
  statusHistory   OrderStatusHistory[]
}

model OrderItem {
  id            String      @id @default(cuid())
  orderId       String
  productLinkId String
  quantity      Int         @default(1)
  unitPrice     Int
  totalPrice    Int
  variantLabel  String?
  createdAt     DateTime    @default(now())
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productLink   ProductLink @relation(fields: [productLinkId], references: [id], onDelete: Restrict)
}

model PaymentIntent {
  id                String              @id @default(cuid())
  orderId           String
  provider          PaymentProviderName @default(pagopar_upay)
  method            PaymentMethodType?
  externalReference String?
  amount            Int
  currency          String              @default("PYG")
  status            PaymentStatus       @default(pending)
  riskState         PaymentRiskState    @default(pending)
  fundsReleased     Boolean             @default(false)
  providerMetadata  Json?
  expiresAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  order             Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events            PaymentEvent[]
}

model PaymentEvent {
  id               String              @id @default(cuid())
  paymentIntentId  String?
  provider         PaymentProviderName
  externalEventId  String?
  eventType        String
  payload          Json
  receivedAt       DateTime            @default(now())
  processedAt      DateTime?
  processingResult String?
  paymentIntent    PaymentIntent?      @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)

  @@unique([provider, externalEventId])
}

model OrderStatusHistory {
  id            String      @id @default(cuid())
  orderId       String
  fromStatus    OrderStatus?
  toStatus      OrderStatus
  changedByType String?
  changedById   String?
  reason        String?
  createdAt     DateTime    @default(now())
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
