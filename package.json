{
  "name": "next-forge",
  "version": "6.0.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vercel/next-forge.git"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "bin": {
    "next-forge": "dist/index.js"
  },
  "files": [
    "dist/index.js"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "turbo test",
    "analyze": "turbo analyze",
    "translate": "turbo translate",
    "boundaries": "turbo boundaries",
    "bump-deps": "bunx npm-check-updates --deep -u && bun install",
    "bump-ui": "bunx shadcn@latest add --all --overwrite -c packages/design-system",
    "db:generate": "bun run --cwd packages/database db:generate",
    "db:clean": "bun run --cwd packages/database db:clean",
    "db:migrate": "bun run --cwd packages/database db:migrate",
    "db:normalize-images": "bun run --cwd packages/database db:normalize-images",
    "db:push": "bun run --cwd packages/database db:push",
    "db:studio": "bun run --cwd packages/database db:studio",
    "migrate": "bun run db:generate && bun run db:migrate",
    "migrate:deploy": "bun run db:migrate",
    "hermes:pr-review": "bash ./scripts/hermes-pr-review.sh",
    "hermes:devops": "bash ./scripts/hermes-devops.sh",
    "clean": "git clean -xdf node_modules",
    "release": "npm publish"
  },
  "devDependencies": {
    "@auto-it/first-time-contributor": "^11.3.6",
    "@biomejs/biome": "2.4.14",
    "@repo/typescript-config": "workspace:*",
    "@turbo/gen": "^2.9.9",
    "@types/node": "^25.6.0",
    "tsup": "^8.5.1",
    "turbo": "^2.9.9",
    "typescript": "^6.0.3",
    "ultracite": "7.6.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.13",
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "commander": "^14.0.3",
    "nypm": "^0.6.6"
  },
  "overrides": {
    "parse5": "^7.2.1"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
